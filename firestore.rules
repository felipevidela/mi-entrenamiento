rules_version = '2';

// Cada persona lee y escribe solo su propio registro.
service cloud.firestore {
  match /databases/{database}/documents {
    // perfil: por ahora solo la estatura, que el peso necesita para el IMC
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usuarios/{uid}/sesiones/{sesion} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usuarios/{uid}/pesos/{peso} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
